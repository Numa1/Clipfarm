{
  "name": "clipfarm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx watch --clear-screen=false worker/index.ts",
    "worker:once": "tsx worker/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "uv run --quiet --with pytest --with 'opencv-python-headless>=4.9,<5' --with 'numpy>=1.26' pytest -q scripts/test_reframe.py",
    "db:generate": "drizzle-kit generate",
    "setup:all": "pnpm setup:whisper && pnpm setup:models",
    "setup:whisper": "./scripts/setup-whisper.sh",
    "setup:models": "./scripts/setup-models.sh",
    "studio": "remotion studio src/remotion/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@remotion/bundler": "^4.0.537",
    "@remotion/media-utils": "^4.0.537",
    "@remotion/player": "^4.0.537",
    "@remotion/renderer": "^4.0.537",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "immer": "^11.1.21",
    "lucide-react": "^1.59.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.537",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.537",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.13.1"
}
