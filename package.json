{
  "name": "clipfarm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "worker": "tsx watch --clear-screen=false worker/index.ts",
    "worker:once": "tsx worker/index.ts",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx e2e/pipeline.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:py": "uv run --quiet --with pytest --with 'opencv-python-headless>=4.9,<5' --with 'numpy>=1.26' pytest -q scripts/test_reframe.py",
    "db:generate": "drizzle-kit generate",
    "setup:all": "pnpm setup:whisper && pnpm setup:models",
    "setup:whisper": "./scripts/setup-whisper.sh",
    "setup:models": "./scripts/setup-models.sh",
    "studio": "remotion studio src/remotion/index.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.23.0",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@react-aria/utils": "^3.34.1",
    "@remotion/bundler": "^4.0.537",
    "@remotion/media-utils": "^4.0.537",
    "@remotion/player": "^4.0.537",
    "@remotion/renderer": "^4.0.537",
    "better-sqlite3": "^13.0.3",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "immer": "^11.1.21",
    "motion": "^14.4.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.6",
    "react-stately": "^3.51.0",
    "remotion": "^4.0.537",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.537",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.13.1"
}
